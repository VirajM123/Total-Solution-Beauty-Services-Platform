NODE_ENV=development
PORT=5000
MONGODB_URI=
MONGODB_DB_NAME=hii_beauty_dev
ADMIN_CATALOG_API_ENABLED=false
SESSION_COOKIE_SECRET=
ADMIN_SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to a device-reachable API base when testing private product photos from a phone.
DEVELOPMENT_MEDIA_BASE_URL=
# Persistent private product evidence (standard AWS credential chain).
AWS_REGION=
S3_BUCKET=
# Required only for public catalog assets; product evidence uses signed access.
S3_PUBLIC_BASE_URL=
JSON_BODY_LIMIT=1mb
MONGODB_CONNECT_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000

# Enable only after validator review and live Admin authentication verification.
ADMIN_OPERATIONS_API_ENABLED=false
LEGACY_WORKER_OFFERS_ENABLED=false

# Razorpay credentials stay on the backend; never put the key secret in a mobile app.
RAZORPAY_ENABLED=true
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR
RAZORPAY_QR_ENABLED=true

# MSG91 is used only for mobile login/registration verification.
OTP_PROVIDER=msg91
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER_TIMEOUT_MS=10000

# Device push (configure Google Application Default Credentials on the server).
# Run npm run provision:push before enabling; never put server credentials in a mobile app.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
